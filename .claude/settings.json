{
  "permissions": {
    "allow": [
      "WebFetch(domain:espressif.com)",
      "WebFetch(domain:docs.espressif.com)",
      "WebFetch(domain:developer.espressif.com)",
      "WebFetch(domain:components.espressif.com)",

      "WebFetch(domain:github.com)",

      "WebFetch(domain:platform.claude.com)",
      "WebFetch(domain:code.claude.com)",

      "WebFetch(domain:x.ai)",
      "WebFetch(domain:docs.x.ai)",
      
      "Bash(ls:*)",
      "Bash(find:*)",
      "Bash(type:*)",
      "Bash(git diff:*)",

      "Bash(*setup-ralph-loop.sh*)"
    ]
  },
  "autoMemoryEnabled": true,
  "enableWorkflows": true,
  "ultracode": true,
  "enabledPlugins": {
    "ralph-loop@claude-plugins-official": true
  }
}
