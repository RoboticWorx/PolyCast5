  restat = 1

build esp-idf/bt/edit_cache: phony esp-idf/bt/CMakeFiles/edit_cache.util


#############################################
# Utility command for rebuild_cache

build esp-idf/bt/CMakeFiles/rebuild_cache.util: CUSTOM_COMMAND
