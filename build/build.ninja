  LANGUAGE_COMPILE_FLAGS = -march=rv32imac_zicsr_zifencei
  OBJECT_DIR = esp-idf\main\CMakeFiles\__idf_main.dir
  POST_BUILD = cd .
  PRE_LINK = cd .
  TARGET_FILE = esp-idf\main\libmain.a
  TARGET_PDB = main.a.dbg


